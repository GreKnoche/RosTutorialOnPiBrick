<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>brick_drive</name>
  <version>0.1.0</version>
  <description>Action server that drives a distance and yaw using wheel odometry.</description>
  <maintainer email="gregor_knoche@outlook.de">gregor</maintainer>
  <license>Apache-2.0</license>

  <depend>brick_core</depend>
  <depend>brick_interfaces</depend>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
