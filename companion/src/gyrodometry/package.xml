<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gyrodometry</name>
  <version>0.1.0</version>
  <description>Borenstein gyrodometry: fuse companion /odom with /imu onto /odom/gyro.</description>
  <maintainer email="gregor.knoche@stud.htwk-leipzig.de">gregor</maintainer>
  <license>Apache-2.0</license>

  <depend>brick_math</depend>
  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
