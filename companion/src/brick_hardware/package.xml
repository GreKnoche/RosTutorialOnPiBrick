<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>brick_hardware</name>
  <version>0.1.0</version>
  <description>Companion ROS 2 backend: kinematic twin. Hardware joins brick_hw over DDS.</description>
  <maintainer email="gregor_knoche@outlook.de">gregor</maintainer>
  <license>Apache-2.0</license>

  <depend>brick_core</depend>
  <depend>brick_description</depend>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>ament_index_python</depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
