<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>brick_bringup</name>
  <version>0.1.0</version>
  <description>Composable launch for the Pi brick Nav2 tutorial (sim, hardware, or Gazebo).</description>
  <maintainer email="gregor_knoche@outlook.de">gregor</maintainer>
  <license>Apache-2.0</license>

  <depend>brick_core</depend>
  <depend>brick_description</depend>
  <depend>brick_hardware</depend>
  <depend>brick_nav</depend>
  <depend>gyrodometry</depend>
  <depend>rclpy</depend>
  <depend>ament_index_python</depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rviz_imu_plugin</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
